\title "Cicha noc"
\subtitle "Kolęda"
\tempo 90
\ts 3 4
\chord ("G" 3 0 0 0 2 3)
\chord ("C" 0 1 0 2 3 x)
\chord ("D7" 2 1 2 0 x x)
\lyrics "Ci- i- cha noc, świę- ę- ta noc
Po- kój niesie lu- dziom wszem,
A u żłó- ó- bka Ma- a- tka święta
Czu- wa sa- a- ma, u- u- śmiech- nięta,
Nad Dzie- cią- ą- tka sne- em,
Na- ad Dzie- cią- ą- tka snem."
.
